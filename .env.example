# Turso (leave empty to use local SQLite)
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest

DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-4-5

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ── Admin panel ───────────────────────────────────────────────────────────────
# You sign in passwordlessly: /admin/login emails a single-use link to
# ADMIN_EMAIL. Needs the SMTP_* variables below to be working.
ADMIN_EMAIL=
ADMIN_LOGIN_TOKEN_MINUTES=15
ADMIN_SESSION_DAYS=30

# ADMIN_PASSWORD is a *machine* credential — the supercronic cron process uses it
# for HTTP Basic Auth. You never need to type or remember it; it just lives here
# and in the Fly secret store. The app refuses to start on Fly without it.
# Generate with: python -c "import secrets,string; print(''.join(secrets.choice(string.ascii_letters+string.digits) for _ in range(32)))"
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Signs session cookies and the anti-bot form tokens. Also required on Fly.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET_KEY=

# ── Anti-bot limits ───────────────────────────────────────────────────────────
# Accounts / newsletter signups a single IP may create per day.
MAX_SIGNUPS_PER_IP_PER_DAY=3
MAX_SUBSCRIPTIONS_PER_IP_PER_DAY=3

# Extra email domains to reject, comma-separated (added to the built-in
# disposable-provider blocklist in services/antibot.py).
BLOCKED_EMAIL_DOMAINS=
