# Turso (leave empty to use local SQLite)
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Pipeline: step 1 simplifies + translates, step 2 reviews.
LLM_PROVIDER=mistral
REVIEW_LLM_PROVIDER=qwen

MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest

DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-4-5

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-pro

# Qwen (Alibaba QwenCloud / DashScope, OpenAI-compatible).
# DASHSCOPE_API_KEY also works. Models: qwen3.8-max, qwen3.7-plus, qwen3.7-flash
QWEN_API_KEY=
QWEN_MODEL=qwen3.7-plus

# ── Read-aloud audio (optional) ───────────────────────────────────────────────
# Leave TTS_PROVIDER=none to use the browser's built-in speech instead. Audio is
# generated on first listen and cached on disk, so each article costs one
# synthesis regardless of how many people play it.
# Check the available voices with:
#   python -m services.tts_service --list-voices
TTS_PROVIDER=none                # gemini | none

# Uses GEMINI_API_KEY above — get one free at https://aistudio.google.com/apikey
# with no billing setup. The API returns raw PCM only, so ffmpeg compresses it;
# ffmpeg is in the Docker image, and without it the cache stores larger WAVs.
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
GEMINI_VOICE_FINNISH=Kore
GEMINI_VOICE_GERMAN=Kore

# Stored audio format. mp3 plays everywhere; opus is ~35% smaller but Ogg/Opus
# support on Safari/iOS has been unreliable.
TTS_AUDIO_FORMAT=mp3             # mp3 | opus
TTS_AUDIO_BITRATE=               # optional; defaults to 64k mp3 / 32k opus
FFMPEG_PATH=                     # optional; only if ffmpeg is not on PATH

# Cache ceiling. Past this, the least-recently-played file is deleted; it simply
# re-synthesises if somebody plays that article again. 0 disables the limit.
TTS_CACHE_MAX_FILES=50

# AUDIO_DIR defaults to an "audio" folder next to the database.
AUDIO_DIR=

# ── Admin panel ───────────────────────────────────────────────────────────────
# You sign in passwordlessly: /admin/login emails a single-use link to
# ADMIN_EMAIL. Needs the SMTP_* variables below to be working.
ADMIN_EMAIL=
ADMIN_LOGIN_TOKEN_MINUTES=15
ADMIN_SESSION_DAYS=30

# ADMIN_PASSWORD is a *machine* credential — the supercronic cron process uses it
# for HTTP Basic Auth. You never need to type or remember it; it just lives here
# and in the Fly secret store. The app refuses to start on Fly without it.
# Generate with: python -c "import secrets,string; print(''.join(secrets.choice(string.ascii_letters+string.digits) for _ in range(32)))"
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Signs session cookies and the anti-bot form tokens. Also required on Fly.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET_KEY=

# ── Anti-bot limits ───────────────────────────────────────────────────────────
# Accounts / newsletter signups a single IP may create per day.
MAX_SIGNUPS_PER_IP_PER_DAY=3
MAX_SUBSCRIPTIONS_PER_IP_PER_DAY=3

# Extra email domains to reject, comma-separated (added to the built-in
# disposable-provider blocklist in services/antibot.py).
BLOCKED_EMAIL_DOMAINS=
